# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
# Required in Production + Preview on Vercel (same value across environments).
AUTH_SECRET=****

# Production site URL (optional; Auth.js uses trustHost on Vercel when unset)
# AUTH_URL=https://your-app.vercel.app

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# --- Supabase (recommended on Vercel) ---
# Dashboard: Project Settings → Database → Connection string
#
# Runtime (app + API routes): Transaction pooler, port 6543
# POSTGRES_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Migrations (`npm run build`, drizzle-kit): Session pooler port 5432 OR direct — NOT :6543
# POSTGRES_URL_NON_POOLING=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# On Vercel: add BOTH vars for Production + Preview; enable both for "Build" so migrations run on deploy.
POSTGRES_URL=****
POSTGRES_URL_NON_POOLING=****

# Optional Supabase client (not used by Drizzle auth/chat DB today)
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Google OAuth
# Get these from https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URIs:
#    http://localhost:3000/api/auth/callback/google
#    https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=****
AUTH_GOOGLE_SECRET=****

# PaiementPro (https://paiementpro.net)
# Public merchant ID used by the browser SDK
NEXT_PUBLIC_PAIEMENT_PRO_MERCHANT_ID=YOUR_MERCHANT_ID

# Public base URL used to build PaiementPro return/notification URLs and password reset links.
# Must be reachable from PaiementPro's servers (use ngrok or your prod URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password reset emails (https://resend.com)
RESEND_API_KEY=re_FCoPg9sW_HNVvtKbT4TQmbpmJLquFFVvn
EMAIL_FROM=Unisecure <onboarding@resend.dev>

# Admin dashboard — comma-separated allowlist (superadmin is always included)
# ADMIN_EMAILS=olawaleoluwaseyi24@gmail.com
